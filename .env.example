# ─────────────────────────────────────────────────────────────────────────
# Adi MCP — environment configuration
#
# Local dev: copy this file to `.dev.vars` inside apps/server/ (wrangler's
# convention for local secrets — NOT `.env`, wrangler does not read `.env`).
# Production: set each secret with `wrangler secret put <NAME>` and each
# plain var in apps/server/wrangler.jsonc `vars`. Never commit real values.
# See docs/DEPLOYMENT.md and docs/OAUTH.md for full setup instructions.
# ─────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────
LOG_LEVEL=info                     # debug | info | warn | error
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=https://claude.ai

# ── Server-level auth (protects the /mcp endpoint itself) ────────────────
# AUTH_STRATEGY selects which packages/auth AuthStrategy guards /mcp.
AUTH_STRATEGY=bearer               # bearer | oauth2

# Used when AUTH_STRATEGY=bearer
MCP_BEARER_TOKEN=

# Used when AUTH_STRATEGY=oauth2 (workers-oauth-provider, see docs/OAUTH.md)
OAUTH_COOKIE_SECRET=

# ── Provider credential encryption ────────────────────────────────────────
# 32-byte base64 key used to encrypt provider OAuth tokens/API keys at rest
# in KV. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# ── X (real implementation) ───────────────────────────────────────────────
# Create an OAuth 2.0 app (with PKCE) at https://developer.x.com
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://your-worker.workers.dev/providers/x/callback

# ── LinkedIn (real implementation) ────────────────────────────────────────
# Create an OAuth 2.0 app at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-worker.workers.dev/providers/linkedin/callback

# ── GitHub (scaffold) ──────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://your-worker.workers.dev/providers/github/callback

# ── Gmail (scaffold, Google OAuth) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-worker.workers.dev/providers/gmail/callback

# ── Google Calendar (scaffold, shares Google OAuth app with Gmail) ────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://your-worker.workers.dev/providers/calendar/callback

# ── Notion (scaffold) ───────────────────────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://your-worker.workers.dev/providers/notion/callback

# ── Obsidian (scaffold, local REST API plugin) ─────────────────────────────
OBSIDIAN_API_URL=http://127.0.0.1:27123
OBSIDIAN_API_KEY=

# ── Postgres (scaffold) ─────────────────────────────────────────────────────
POSTGRES_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/adi_mcp

# ── Supabase (scaffold) ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (scaffold) ────────────────────────────────────────────────────────
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (scaffold) ──────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Filesystem (scaffold) ───────────────────────────────────────────────────
# Absolute path the filesystem provider is sandboxed to; all tool paths are
# resolved and validated to stay within this root.
FILESYSTEM_ROOT=/tmp/adi-mcp-fs

# ── Browser automation (scaffold) ───────────────────────────────────────────
BROWSER_REMOTE_ENDPOINT=
BROWSER_API_KEY=
